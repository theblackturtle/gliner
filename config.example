# GLiNER PII Detection Server - Configuration Example
# Set these as environment variables or update config.py defaults

# Model Configuration
GLINER_MODEL_NAME=urchade/gliner_small-v2.1
GLINER_THRESHOLD=0.3
GLINER_USE_GPU=true

# Performance Configuration
GLINER_CHUNK_SIZE=8000
GLINER_BATCH_SIZE=8
GLINER_MAX_FILE_SIZE=50.0

# Server Configuration
GLINER_HOST=0.0.0.0
GLINER_PORT=8000
GLINER_LOG_LEVEL=info

# Client Configuration
GLINER_SERVER_URL=http://localhost:8000

